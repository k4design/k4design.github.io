{
  "name": "@mf/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:code",
    "build:ui": "vite build",
    "build:code": "node scripts/build-code.mjs",
    "build:prod": "node scripts/build-prod.mjs",
    "dev": "concurrently -n ui,code -c cyan,magenta \"vite build --watch\" \"node scripts/build-code.mjs --watch\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sandbox.json --noEmit"
  },
  "dependencies": {
    "@mf/shared": "*",
    "h264-mp4-encoder": "^1.0.12",
    "mediabunny": "^1.52.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
